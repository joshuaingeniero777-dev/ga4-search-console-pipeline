# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# The master Google Sheet: the long ID in its address, between /d/ and /edit.
SPREADSHEET_ID=1a2B3cD4eFgHiJkLmNoPqRsTuVwXyZ

# Where the data comes from. Neither is a secret.
# The GA4 property's NUMBER (not the "G-XXXX" measurement ID).
# `python scripts/list_ga4_properties.py` lists the ones the pipeline can see.
GA4_PROPERTY_ID=123456789
# The Search Console property, exactly as Search Console names it: either
# "sc-domain:example.org" (a domain property) or "https://example.org/" (a URL property).
GSC_SITE_URL=sc-domain:example.org

# Control panel API (api/): Google sign-in. Without all three, the API refuses everyone.
# From Google Cloud Console > Google Auth Platform > Clients (see docs/ROADMAP.md, item 4).
GOOGLE_OAUTH_CLIENT_ID=1234567890-abc123.apps.googleusercontent.com
# A real secret: never commit it, paste it into chat, or print it.
GOOGLE_OAUTH_CLIENT_SECRET=paste-the-client-secret-here
# At least 32 random characters. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=paste-a-long-random-string-here
# Workspace domains allowed to sign in (comma-separated).
ALLOWED_DOMAINS=starrwellnesscollective.org,joinswc.org

# Alerts go to Slack (docs/decisions.md, decision 26). Without this, alerts stay off.
# The pipeline's Slack incoming-webhook link. A secret: anyone with it can post to the
# channel. Never commit, print or paste it into chat.
SLACK_WEBHOOK_URL=

# Email alerts: kept in the code but UNUSED (decision 28). Only needed if switching to email.
# ALERT_SENDER=alerts@joinswc.org
# ALERT_REFRESH_TOKEN=

# The control panel's address. Google sends people back to <this>/backend/auth/callback,
# and saves and runs are only accepted from this address.
PANEL_ORIGIN=http://localhost:3000
